{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types/worker"
  },
  "include": [
    "src/worker/**/*",
    "src/contract/**/*",
    "src/generated/**/*",
    "src/model/domain/Metric/metricCatalogue.ts",
    "src/model/domain/Metric/collectionItems.ts",
    "test/**/*",
    "tools/**/*",
    "scripts/**/*",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
